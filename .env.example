# Copy to .env locally. Never commit .env or share its contents.
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=

MONGODB_URI=
MONGODB_DB_NAME=rapstore

# Discord server IDs (defaults are the IDs supplied for RapStore)
FOUNDER_ROLE_ID=1549754249485877288
ADMIN_ROLE_ID=1549942317249593425
SUPPORT_CATEGORY_ID=1552879597601820732

# Manual order payment settings. Leave blank until the store payment details are confirmed.
PAYMENT_QRIS_IMAGE_URL=
PAYMENT_BANK_NAME=
PAYMENT_BANK_ACCOUNT_NAME=
PAYMENT_BANK_ACCOUNT_NUMBER=

# Discord text channel IDs; transcripts are uploaded before ticket channels are deleted.
VOUCH_CHANNEL_ID=
TRANSCRIPT_CHANNEL_ID=

# Backblaze B2 S3-compatible storage for permanent ticket transcript attachments.
# Use the S3 endpoint and region shown in your bucket details, plus an application key scoped to this bucket.
# Set the bucket to Public and use its public download base URL, e.g. https://f005.backblazeb2.com/file/your-bucket-name
# Anyone who obtains these public URLs may view/download the files; never put secrets in the public URL.
B2_S3_ENDPOINT=
B2_REGION=
B2_ACCESS_KEY_ID=
B2_SECRET_ACCESS_KEY=
B2_BUCKET_NAME=
B2_PUBLIC_BASE_URL=

LOG_LEVEL=info
